generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         UserRole @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model AdminUser {
  id                       String              @id @default(cuid())
  email                    String              @unique
  displayName              String
  passwordHash             String
  isActive                 Boolean             @default(true)
  twoFactorEnabled         Boolean             @default(false)
  twoFactorSecretEncrypted String?
  twoFactorConfirmedAt     DateTime?
  lastLoginAt              DateTime?
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt
  roles                    AdminUserRole[]
  sessions                 AdminSession[]
  auditLogs                AdminAuditLog[]
  adminRecoveryCodes       AdminRecoveryCode[]

  @@index([isActive])
}

/// One-time codes that let an admin who has lost their password set a new one
/// without any mail server, SMS gateway, or third-party account existing. The
/// plaintext is shown once, when the code is issued, and only its hash is kept.
model AdminRecoveryCode {
  id          String    @id @default(cuid())
  adminUserId String
  codeHash    String    @unique
  usedAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
  @@index([usedAt])
}

model AdminRole {
  id          String                @id @default(cuid())
  key         String                @unique
  name        String
  description String
  isSystem    Boolean               @default(true)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  users       AdminUserRole[]
  permissions AdminRolePermission[]

  @@index([isSystem])
}

model AdminPermission {
  id          String                @id @default(cuid())
  key         String                @unique
  resource    String
  action      String
  description String
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  roles       AdminRolePermission[]
}

model AdminUserRole {
  id          String    @id @default(cuid())
  adminUserId String
  adminRoleId String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  role        AdminRole @relation(fields: [adminRoleId], references: [id], onDelete: Cascade)

  @@unique([adminUserId, adminRoleId])
  @@index([adminRoleId])
}

model AdminRolePermission {
  id                String          @id @default(cuid())
  adminRoleId       String
  adminPermissionId String
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  role              AdminRole       @relation(fields: [adminRoleId], references: [id], onDelete: Cascade)
  permission        AdminPermission @relation(fields: [adminPermissionId], references: [id], onDelete: Cascade)

  @@unique([adminRoleId, adminPermissionId])
  @@index([adminPermissionId])
}

model AdminSession {
  id               String          @id @default(cuid())
  adminUserId      String
  refreshTokenHash String
  expiresAt        DateTime
  revokedAt        DateTime?
  lastUsedAt       DateTime?
  ipAddress        String?
  userAgent        String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  adminUser        AdminUser       @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  auditLogs        AdminAuditLog[]

  @@index([adminUserId])
  @@index([expiresAt])
  @@index([revokedAt])
}

model AdminAuditLog {
  id               String        @id @default(cuid())
  actorAdminUserId String?
  actorEmail       String?
  action           String
  resource         String
  resourceId       String?
  method           String?
  path             String?
  requestId        String?
  ipAddress        String?
  userAgent        String?
  before           Json?
  after            Json?
  metadata         Json?
  sessionId        String?
  createdAt        DateTime      @default(now())
  actorAdminUser   AdminUser?    @relation(fields: [actorAdminUserId], references: [id], onDelete: SetNull)
  session          AdminSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([actorAdminUserId])
  @@index([resource])
  @@index([action])
  @@index([createdAt])
}

model SiteConfig {
  id                  String    @id @default(cuid())
  name                String
  shortName           String
  descriptor          String
  defaultTitle        String
  description         String
  contactEmail        String
  responseWindow      String
  statusLabel         String
  intakeMode          String
  // Home page copy. Editable rather than hardcoded in the frontend.
  heroHeadline        String    @default("Built once, properly")
  positionTitle       String    @default("Most of the value is in deciding what not to build.")
  positionBody        String    @default("")
  // Where people can reach the studio outside the form. Empty hides the link.
  socialTiktok        String?
  socialInstagram     String?
  socialFacebook      String?
  socialX             String?
  socialLinkedin      String?
  socialYoutube       String?
  /// International format without spaces or "+", e.g. 251911234567.
  whatsappNumber      String?
  /// Username without the "@".
  telegramHandle      String?
  // The strip above the header.
  announcementEnabled Boolean   @default(false)
  announcementText    String?
  announcementLink    String?
  /// Plausible-style analytics: the domain as registered with the provider.
  analyticsDomain     String?
  analyticsScriptUrl  String?
  /// Fallback share image for pages without one of their own.
  ogImageUrl          String?
  deletedAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([deletedAt])
}

model PrimaryNavigation {
  id        String    @id @default(cuid())
  position  Int
  to        String
  label     String
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([position])
  @@index([deletedAt])
}

model InquiryProjectType {
  id        String    @id @default(cuid())
  position  Int
  value     String
  label     String
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([position])
  @@index([deletedAt])
}

model InquiryBudgetRange {
  id        String    @id @default(cuid())
  position  Int
  value     String
  label     String
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([position])
  @@index([deletedAt])
}

model HomeManifesto {
  id        String    @id @default(cuid())
  position  Int
  icon      String
  kicker    String
  title     String
  copy      String
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([position])
  @@index([deletedAt])
}

model HomeEcosystemTag {
  id        String    @id @default(cuid())
  position  Int
  tag       String
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([position])
  @@index([deletedAt])
}

model HomeStat {
  id        String    @id @default(cuid())
  position  Int
  label     String
  value     Int
  suffix    String?
  /// "manual" uses `value` as typed. Anything else is counted from published
  /// work when the content bundle is built, and `value` is ignored.
  source    String    @default("manual")
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([position])
  @@index([deletedAt])
}

model Service {
  id            String                @id @default(cuid())
  position      Int
  icon          String
  name          String
  handle        String                @unique
  summary       String
  /// Address of the service's own landing page: /services/<slug>.
  slug          String?
  tagline       String?
  imageUrl      String?
  deliverables  String[]              @default([])
  /// How long an engagement of this kind usually takes, e.g. "6-10 weeks".
  timeline      String?
  /// Optional price anchor, e.g. "$4,000". Empty hides it.
  startingFrom  String?
  deletedAt     DateTime?
  capabilities  ServiceCapability[]
  stackItems    ServiceStackItem[]
  interconnects ServiceInterconnect[]
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@unique([position])
  @@index([deletedAt])
}

model ServiceCapability {
  id        String   @id @default(cuid())
  serviceId String
  position  Int
  value     String
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([serviceId, position])
}

model ServiceStackItem {
  id        String   @id @default(cuid())
  serviceId String
  position  Int
  value     String
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([serviceId, position])
}

model ServiceInterconnect {
  id        String   @id @default(cuid())
  serviceId String
  position  Int
  value     String
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([serviceId, position])
}

model ServicePipelineStep {
  id        String    @id @default(cuid())
  position  Int
  icon      String
  label     String
  step      String
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([position])
  @@index([deletedAt])
}

model WorkFilter {
  id        String    @id @default(cuid())
  position  Int
  value     String
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([position])
  @@index([deletedAt])
}

model WorkProject {
  id               String                  @id @default(cuid())
  position         Int
  projectKey       String                  @unique
  title            String
  client           String
  year             String
  summary          String
  coverImageUrl    String?
  // Case study body. Optional so a project can be listed before it is written up.
  challenge        String?
  approach         String?
  outcome          String?
  // Showcase. `surface` decides which frame the screenshots are shown in on
  // the work page — a phone body, browser chrome, or both side by side.
  surface          String                  @default("web")
  liveUrl          String?
  appStoreUrl      String?
  playStoreUrl     String?
  /// Something that can run inside an iframe on the work page: a web build of
  /// the app, a hosted demo, or a device-farm embed. Falls back to liveUrl.
  demoUrl          String?
  // One headline result per project, shown on the showcase card.
  metricValue      String?
  metricLabel      String?
  // Home page curation. Replaces the old HomeFeaturedProject table, which
  // duplicated every one of these records.
  featured         Boolean                 @default(false)
  featuredPosition Int?
  /// "draft" | "published". Only published projects reach the public site,
  /// so a project can be built up in admin without appearing half-finished.
  status           String                  @default("draft")
  publishedAt      DateTime?
  tagline          String?
  industry         String?
  /// Any of "android", "ios", "web". Decides `surface` when set.
  platforms        String[]                @default([])
  /// How long the build took, e.g. "12 weeks".
  duration         String?
  /// The product's own colour as #rrggbb. Tints the preview room.
  brandColor       String?
  /// The uploaded web build of the app (flutter build web, zipped), served
  /// by the API at /api/apps/<appBuildId>/. Null when none is uploaded.
  appBuildId       String?
  appBuildFiles    Int?
  appBuildBytes    Int?
  appBuildFilename String?
  appBuildAt       DateTime?
  deletedAt        DateTime?
  disciplines      WorkProjectDiscipline[]
  stackItems       WorkProjectStackItem[]
  media            WorkProjectMedia[]
  highlights       WorkProjectHighlight[]
  screens          PrototypeScreen[]
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  @@unique([position])
  @@index([deletedAt])
  @@index([surface])
  @@index([status])
}

model WorkProjectStackItem {
  id        String      @id @default(cuid())
  projectId String
  position  Int
  value     String
  project   WorkProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([projectId, position])
}

/// Screenshots shown inside a device frame on the work page. Keyed by the
/// project slug rather than its cuid, so a row can be added from the generic
/// admin editor without looking an id up first.
model WorkProjectMedia {
  id         String      @id @default(cuid())
  projectKey String
  position   Int
  url        String
  /// "phone" | "browser" | "plain" — which frame the shot is drawn in.
  kind       String      @default("browser")
  caption    String?
  /// Which page of a website this capture shows ("Home", "Pricing"). Shots
  /// sharing a label are the same page at different sizes.
  pageLabel  String?
  /// A short muted loop shown in place of the still where supported.
  videoUrl   String?
  deletedAt  DateTime?
  project    WorkProject @relation(fields: [projectKey], references: [projectKey], onDelete: Cascade)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@unique([projectKey, position])
  @@index([deletedAt])
}

/// A project enquiry submitted from the public site. Stored so nobody has to
/// leave the page to send one, and so none are lost in a mailbox.
model Inquiry {
  id          String    @id @default(cuid())
  reference   String    @unique
  name        String
  email       String
  company     String?
  projectType String
  budget      String
  message     String
  /// Which form it came from: "home", "contact", or "project".
  source      String    @default("contact")
  /// Set when the enquiry starts from a specific case study.
  projectKey  String?
  /// How soon they want to start, as chosen on the form.
  timeline    String?
  // Attribution, captured from the visit that led to the enquiry.
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  referrer    String?
  landingPath String?
  /// Private notes from whoever is handling it.
  notes       String?
  status      String    @default("new")
  ipHash      String?
  userAgent   String?
  handledAt   DateTime?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([deletedAt])
}

model WorkProjectDiscipline {
  id        String      @id @default(cuid())
  projectId String
  position  Int
  value     String
  project   WorkProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([projectId, position])
}

/// One headline feature of a project, shown as a step in its case study's
/// pinned highlight scene.
model WorkProjectHighlight {
  id         String      @id @default(cuid())
  projectKey String
  position   Int
  title      String
  body       String
  /// The screen shown while this highlight is on stage.
  mediaUrl   String?
  deletedAt  DateTime?
  project    WorkProject @relation(fields: [projectKey], references: [projectKey], onDelete: Cascade, onUpdate: Cascade)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([projectKey])
  @@index([deletedAt])
}

/// One screen of a tap-through app prototype.
model PrototypeScreen {
  id            String             @id @default(cuid())
  projectKey    String
  /// Stable name hotspots point at, e.g. "home" or "checkout".
  screenKey     String
  position      Int
  title         String
  imageUrl      String
  /// Natural pixel size of the image, so the frame can be laid out before it loads.
  width         Int
  height        Int
  isStart       Boolean            @default(false)
  /// A screen taller than the phone scrolls inside it.
  scrollable    Boolean            @default(false)
  /// Colour of the status bar icons drawn over this screen: "dark" | "light".
  statusBarTone String             @default("dark")
  deletedAt     DateTime?
  project       WorkProject        @relation(fields: [projectKey], references: [projectKey], onDelete: Cascade, onUpdate: Cascade)
  hotspots      PrototypeHotspot[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@unique([projectKey, screenKey])
  @@index([deletedAt])
}

/// A tappable area on a prototype screen. Coordinates are fractions of the
/// screen image (0-1), so they hold at any rendered size.
model PrototypeHotspot {
  id              String          @id @default(cuid())
  screenId        String
  position        Int
  x               Float
  y               Float
  w               Float
  h               Float
  /// "goto" | "back" | "url"
  action          String          @default("goto")
  targetScreenKey String?
  url             String?
  /// "push" | "modal" | "fade" | "none"
  transition      String          @default("push")
  label           String?
  deletedAt       DateTime?
  screen          PrototypeScreen @relation(fields: [screenId], references: [id], onDelete: Cascade)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([screenId])
  @@index([deletedAt])
}

/// Every piece of fixed wording on the public site, keyed by where it appears
/// ("home.hero.eyebrow"). One table instead of one per sentence.
model SiteCopy {
  id        String    @id @default(cuid())
  key       String    @unique
  page      String
  section   String
  label     String
  value     String
  /// "text" | "longtext" | "url"
  kind      String    @default("text")
  helpText  String?
  position  Int       @default(0)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([page])
  @@index([deletedAt])
}

model Testimonial {
  id         String    @id @default(cuid())
  position   Int
  quote      String
  name       String
  role       String
  company    String
  avatarUrl  String?
  /// Ties the quote to a case study, where it is shown as well.
  projectKey String?
  featured   Boolean   @default(true)
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([deletedAt])
  @@index([projectKey])
}

/// A client shown on the proof wall, with the result the work produced.
model ClientLogo {
  id           String    @id @default(cuid())
  position     Int
  name         String
  logoUrl      String?
  siteUrl      String?
  outcomeValue String?
  outcomeLabel String?
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([deletedAt])
}

model Faq {
  id        String    @id @default(cuid())
  position  Int
  /// "home" | "services" | "contact" | "service:<slug>"
  scope     String    @default("home")
  question  String
  answer    String
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([scope])
  @@index([deletedAt])
}

model LabPrinciple {
  id        String    @id @default(cuid())
  position  Int
  icon      String
  name      String
  desc      String
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([position])
  @@index([deletedAt])
}

model LabMatrixRow {
  id        String    @id @default(cuid())
  position  Int
  label     String
  value     String
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([position])
  @@index([deletedAt])
}

model LabSpec {
  id        String    @id @default(cuid())
  position  Int
  label     String
  value     String
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([position])
  @@index([deletedAt])
}

enum UserRole {
  ADMIN
  USER
}
