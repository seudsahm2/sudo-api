NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/sudo_api?schema=public
JWT_SECRET=replace-with-a-very-long-random-secret-value
JWT_EXPIRES_IN=1h
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,http://localhost:8080
RATE_LIMIT_MAX=120
RATE_LIMIT_TIME_WINDOW=1 minute
ADMIN_EMAIL=admin@sudotechlabs.com
ADMIN_PASSWORD_HASH=$2b$10$JfQb6T4vrA2aTQdzYJ8m5eY4i8VmEvFziW0o0zjY2xXn47jRd5GRe
ADMIN_JWT_SECRET=replace-with-a-separate-admin-jwt-secret-before-production
ADMIN_ACCESS_TOKEN_EXPIRES_IN=15m
ADMIN_REFRESH_TOKEN_EXPIRES_IN=30d
ADMIN_2FA_ENCRYPTION_KEY=replace-with-a-separate-admin-2fa-encryption-key
ADMIN_2FA_ISSUER=Sudo Tech Labs Admin

# ---------------------------------------------------------------------------
# Object storage (S3-compatible: Supabase Storage, Cloudflare R2, AWS S3).
# Leave blank to disable upload — cover image URLs can still be pasted by hand.
# ---------------------------------------------------------------------------
STORAGE_S3_ENDPOINT=
STORAGE_S3_REGION=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
STORAGE_BUCKET=
STORAGE_PUBLIC_URL_BASE=
STORAGE_MAX_UPLOAD_BYTES=10485760
